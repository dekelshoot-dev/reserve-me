# Mode d'exécution (définie automatiquement par Render ou plateforme cloud)
NODE_ENV=production

# Port d'écoute (défini automatiquement par Render ou plateforme cloud)
PORT=10000

# Clé d'API Gemini (Optionnel - Pour l'assistant IA de rédaction de messages et résumés)
GEMINI_API_KEY="votre_cle_gemini_api"

# Domaine public officiel (HTTPS, sans slash final) - Utilisé pour les balises canoniques, OpenGraph, robots.txt et sitemap.xml
PUBLIC_SITE_URL="https://reserve-me.dekel-dev.com"
VITE_PUBLIC_SITE_URL="https://reserve-me.dekel-dev.com"

# Configuration SMTP Persistante Reserve Me (Utilisée par Nodemailer)
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@reserve-me.io
SMTP_PASSWORD=votre_mot_de_passe_application_smtp
SMTP_FROM_NAME="Reserve Me"
SMTP_FROM_EMAIL=notifications@reserve-me.io
