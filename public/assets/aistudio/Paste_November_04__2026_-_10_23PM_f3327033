<script>
  let currentProvider = 'gmail';

  function setPort(portNumber, securityType) {
    document.getElementById('smtpPort').value = portNumber;
    
    // Update radio
    const radio = document.querySelector(`input[name="securityType"][value="${securityType}"]`);
    if (radio) {
      radio.checked = true;
    }

    // Update pill appearance
    ['465', '587', '25'].forEach(p => {
      const el = document.getElementById(`portPill${p}`);
      if (p === String(portNumber)) {
        el.className = 'px-2.5 py-2 rounded-lg bg-primary-container text-on-primary font-code-xs text-code-xs font-semibold shadow-xs flex-1 transition-colors text-center';
      } else {
        el.className = 'px-2.5 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-code-xs text-code-xs font-medium flex-1 transition-colors text-center';
      }
    });
  }

  function handleSecurityChange(secType) {
    if (secType === 'ssl') {
      document.getElementById('smtpPort').value = 465;
      setPort(465, 'ssl');
    } else if (secType === 'starttls') {
      document.getElementById('smtpPort').value = 587;
      setPort(587, 'starttls');
    } else {
      document.getElementById('smtpPort').value = 25;
      setPort(25, 'none');
    }
  }

  function togglePasswordVisibility() {
    const pwdInput = document.getElementById('smtpPassword');
    const eyeIcon = document.getElementById('eyeIcon');
    if (pwdInput.type === 'password') {
      pwdInput.type = 'text';
      eyeIcon.textContent = 'visibility';
    } else {
      pwdInput.type = 'password';
      eyeIcon.textContent = 'visibility_off';
    }
  }

  function selectProvider(provider) {
    currentProvider = provider;
    const gmailCard = document.getElementById('providerGmailCard');
    const customCard = document.getElementById('providerCustomCard');
    const customCheck = document.getElementById('customCheckIcon');

    if (provider === 'gmail') {
      gmailCard.className = "cursor-pointer p-space-md rounded-xl bg-surface-container-lowest shadow-md relative overflow-hidden transition-all duration-200 group";
      customCard.className = "cursor-pointer p-space-md rounded-xl bg-surface-container-low shadow-sm opacity-90 hover:opacity-100 hover:bg-surface-container-lowest transition-all duration-200 group";
      customCheck.classList.add('text-transparent');
      customCheck.classList.remove('bg-secondary', 'text-on-secondary');
      
      document.getElementById('smtpHost').value = 'smtp.gmail.com';
      document.getElementById('smtpPort').value = '465';
      document.getElementById('smtpUser').value = 'notifications@reserve-me.io';
      setPort(465, 'ssl');
      showToast("Profil prédéfini Gmail SMTP appliqué.");
    } else {
      customCard.className = "cursor-pointer p-space-md rounded-xl bg-surface-container-lowest shadow-md relative overflow-hidden transition-all duration-200 group";
      gmailCard.className = "cursor-pointer p-space-md rounded-xl bg-surface-container-low shadow-sm opacity-90 hover:opacity-100 hover:bg-surface-container-lowest transition-all duration-200 group";
      customCheck.classList.remove('text-transparent');
      customCheck.classList.add('bg-secondary', 'text-on-secondary');

      document.getElementById('smtpHost').value = 'mail.votre-domaine.com';
      document.getElementById('smtpPort').value = '587';
      document.getElementById('smtpUser').value = 'smtp-relay@votre-domaine.com';
      setPort(587, 'starttls');
      showToast("Profil SMTP personnalisé activé. Veuillez saisir vos identifiants.");
    }
  }

  function setSmtpState(state) {
    const alertBox = document.getElementById('liveAlertBox');
    const alertIconWrap = document.getElementById('alertIconWrap');
    const alertIcon = document.getElementById('alertIcon');
    const alertTitle = document.getElementById('alertTitle');
    const alertDesc = document.getElementById('alertDescription');
    const alertBadge = document.getElementById('alertLatencyBadge');

    const statusPill = document.getElementById('statusPillContainer');
    const statusText = document.getElementById('statusText');
    const statusSub = document.getElementById('statusSubtext');
    const statusDot = document.getElementById('statusPulseDot');
    const statusIconWrap = document.getElementById('statusIconWrap');

    // Reset simulator buttons styling
    const states = ['Connected', 'Error', 'Unconfigured'];
    states.forEach(s => {
      const btn = document.getElementById(`stateBtn${s}`);
      btn.className = "px-space-sm py-1.5 rounded text-xs font-medium text-on-surface-variant hover:text-on-surface transition-all flex items-center gap-1.5";
    });

    alertBox.classList.remove('hidden');

    if (state === 'connected') {
      document.getElementById('stateBtnConnected').className = "px-space-sm py-1.5 rounded text-xs font-medium bg-surface-container-lowest text-on-surface shadow-xs transition-all flex items-center gap-1.5";

      alertIconWrap.className = "w-8 h-8 rounded-lg bg-secondary/10 flex items-center justify-center shrink-0 text-secondary";
      alertIcon.textContent = "check_circle";
      alertTitle.textContent = "Connexion SMTP établie avec succès";
      alertDesc.innerHTML = 'Le serveur <code class="font-code-xs text-code-xs bg-surface-container px-1 py-0.5 rounded">smtp.gmail.com</code> répond promptement sur le port 465 via SSL/TLS. Les jetons applicatifs sont opérationnels.';
      alertBadge.textContent = "38 ms";
      alertBadge.className = "px-2 py-0.5 rounded font-code-xs text-code-xs bg-surface-container text-on-surface-variant font-medium";

      statusText.textContent = "Connecté";
      statusSub.textContent = "Dernière synchro : il y a 8 min";
      statusDot.innerHTML = '<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span><span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-secondary"></span>';
      statusIconWrap.className = "w-9 h-9 rounded-lg bg-surface-container-low flex items-center justify-center text-secondary";
      statusIconWrap.innerHTML = '<span class="material-symbols-outlined text-[20px]">verified_user</span>';
    } else if (state === 'error') {
      document.getElementById('stateBtnError').className = "px-space-sm py-1.5 rounded text-xs font-medium bg-surface-container-lowest text-on-surface shadow-xs transition-all flex items-center gap-1.5";

      alertIconWrap.className = "w-8 h-8 rounded-lg bg-error-container flex items-center justify-center shrink-0 text-error";
      alertIcon.textContent = "error";
      alertTitle.textContent = "Échec d'authentification SMTP (Code 535)";
      alertDesc.innerHTML = 'Google a rejeté les identifiants : <em>535-5.7.8 Username and Password not accepted</em>. Assurez-vous d\'utiliser un <strong>Mot de passe d\'application</strong> et non votre mot de passe utilisateur principal.';
      alertBadge.textContent = "Timeout / 535";
      alertBadge.className = "px-2 py-0.5 rounded font-code-xs text-code-xs bg-error-container text-on-error-container font-semibold";

      statusText.textContent = "Erreur de connexion";
      statusSub.textContent = "Échec d'authentification";
      statusDot.innerHTML = '<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-error"></span>';
      statusIconWrap.className = "w-9 h-9 rounded-lg bg-error-container flex items-center justify-center text-error";
      statusIconWrap.innerHTML = '<span class="material-symbols-outlined text-[20px]">warning</span>';
    } else if (state === 'unconfigured') {
      document.getElementById('stateBtnUnconfigured').className = "px-space-sm py-1.5 rounded text-xs font-medium bg-surface-container-lowest text-on-surface shadow-xs transition-all flex items-center gap-1.5";

      alertIconWrap.className = "w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center shrink-0 text-on-surface-variant";
      alertIcon.textContent = "info";
      alertTitle.textContent = "Serveur d'envoi non configuré";
      alertDesc.innerHTML = 'Aucun relais SMTP n\'est encore actif. Vos e-mails transactionnels de réservation seront placés dans la file d\'attente locale.';
      alertBadge.textContent = "Inactif";
      alertBadge.className = "px-2 py-0.5 rounded font-code-xs text-code-xs bg-surface-container text-on-surface-variant font-medium";

      statusText.textContent = "Non configuré";
      statusSub.textContent = "En attente de paramètres";
      statusDot.innerHTML = '<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-outline"></span>';
      statusIconWrap.className = "w-9 h-9 rounded-lg bg-surface-container-low flex items-center justify-center text-outline";
      statusIconWrap.innerHTML = '<span class="material-symbols-outlined text-[20px]">link_off</span>';
    }
  }

  function runConnectionTest() {
    const btn = document.getElementById('btnTestConn');
    const icon = document.getElementById('testIcon');
    const text = document.getElementById('testBtnText');

    icon.textContent = 'progress_activity';
    icon.classList.add('animate-spin');
    text.textContent = 'Négociation TLS...';
    btn.disabled = true;

    setTimeout(() => {
      icon.textContent = 'check_circle';
      icon.classList.remove('animate-spin');
      text.textContent = 'Connexion réussie (Code 250 OK)';
      showToast("Handshake SSL réussi : 250-smtp.gmail.com at your service [latence 38ms]");
      setSmtpState('connected');
      setTimeout(() => {
        icon.textContent = 'network_ping';
        text.textContent = 'Tester la connexion';
        btn.disabled = false;
      }, 3500);
    }, 900);
  }

  function openTestEmailDrawer() {
    document.getElementById('testEmailPanel').classList.remove('hidden');
    document.getElementById('testRecipient').focus();
  }

  function closeTestEmailDrawer() {
    document.getElementById('testEmailPanel').classList.add('hidden');
    document.getElementById('dispatchSuccessMsg').classList.add('hidden');
  }

  function dispatchTestEmail() {
    const btn = document.getElementById('btnDispatchTestMail');
    const txt = document.getElementById('dispatchText');
    txt.textContent = 'Envoi...';
    btn.disabled = true;

    setTimeout(() => {
      txt.textContent = 'Expédier maintenant';
      btn.disabled = false;
      document.getElementById('dispatchSuccessMsg').classList.remove('hidden');
      showToast("E-mail témoin transmis avec succès au destinataire !");
    }, 800);
  }

  function handleSaveConfig() {
    const saveBtn = document.getElementById('btnSaveConfig');
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span><span>Enregistrement...</span>';

    setTimeout(() => {
      saveBtn.disabled = false;
      saveBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">save</span><span>Enregistrer la configuration</span>';
      showToast("Configuration SMTP enregistrée et validée au coffre-fort KMS.");
    }, 700);
  }

  function showToast(message) {
    const toast = document.getElementById('toastNotification');
    const msgEl = document.getElementById('toastMsg');
    msgEl.textContent = message;

    toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
    toast.classList.add('translate-y-0', 'opacity-100');

    setTimeout(() => {
      toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 3800);
  }
</script></main></div>

