{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile or practitioner information with subscription plan details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "role": { "type": "string", "enum": ["particulier", "professionnel"] },
        "avatar": { "type": "string", "maxLength": 500 },
        "companyName": { "type": "string", "maxLength": 128 },
        "plan": { "type": "string", "enum": ["free", "pro"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "inactive", "canceled"] },
        "subscriptionPriceXOF": { "type": "number" },
        "checkoutUrl": { "type": "string", "maxLength": 500 },
        "webhookSecret": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Booking or reservation record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reference": { "type": "string", "maxLength": 32 },
        "clientName": { "type": "string", "maxLength": 100 },
        "clientEmail": { "type": "string", "format": "email", "maxLength": 128 },
        "clientPhone": { "type": "string", "maxLength": 32 },
        "clientAvatar": { "type": "string", "maxLength": 500 },
        "serviceTitle": { "type": "string", "maxLength": 128 },
        "serviceDuration": { "type": "string", "maxLength": 32 },
        "location": { "type": "string", "maxLength": 200 },
        "dateStr": { "type": "string", "maxLength": 64 },
        "timeSlot": { "type": "string", "maxLength": 32 },
        "amountXOF": { "type": "number" },
        "paidAmountXOF": { "type": "number" },
        "status": { "type": "string", "enum": ["confirmé", "en_attente", "terminé", "annulé"] },
        "paymentMode": { "type": "string", "maxLength": 100 },
        "paymentStatus": { "type": "string", "enum": ["Payé", "Préautorisation", "Acompte retenu", "En attente (48h)"] },
        "room": { "type": "string", "maxLength": 64 },
        "practitionerNote": { "type": "string", "maxLength": 1000 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["clientName", "clientEmail", "serviceTitle", "dateStr", "timeSlot", "status"]
    },
    "Service": {
      "title": "Service",
      "description": "Service or prestation offer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["cabinet", "visio", "ateliers"] },
        "categoryLabel": { "type": "string", "maxLength": 64 },
        "durationMinutes": { "type": "number" },
        "bufferMinutes": { "type": "number" },
        "priceXOF": { "type": "number" },
        "depositXOF": { "type": "number" },
        "location": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "isActive": { "type": "boolean" },
        "isPopular": { "type": "boolean" }
      },
      "required": ["title", "category", "priceXOF"]
    },
    "Client": {
      "title": "Client",
      "description": "Patient or client contact profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "avatar": { "type": "string", "maxLength": 500 },
        "badge": { "type": "string", "maxLength": 32 },
        "createdDate": { "type": "string", "maxLength": 64 },
        "totalAppointments": { "type": "number" },
        "totalRevenueXOF": { "type": "number" },
        "lastVisitDate": { "type": "string", "maxLength": 64 },
        "nextAppointmentDate": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 2000 }
      },
      "required": ["name", "email", "phone"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial payment transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "reference": { "type": "string", "maxLength": 32 },
        "dateStr": { "type": "string", "maxLength": 64 },
        "clientName": { "type": "string", "maxLength": 100 },
        "serviceTitle": { "type": "string", "maxLength": 128 },
        "paymentMode": { "type": "string", "maxLength": 100 },
        "amountXOF": { "type": "number" },
        "status": { "type": "string", "enum": ["Payé", "Acompte retenu", "En attente (48h)"] }
      },
      "required": ["reference", "clientName", "amountXOF", "status"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Public post or service offer published on Explorer feed",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "businessName": { "type": "string", "maxLength": 150 },
        "rating": { "type": "string", "maxLength": 16 },
        "reviews": { "type": "string", "maxLength": 16 },
        "locationStr": { "type": "string", "maxLength": 200 },
        "priceXOF": { "type": "number" },
        "priceLabel": { "type": "string", "maxLength": 64 },
        "image": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 1000 },
        "isOnline": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "category", "businessName", "priceXOF"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Weekly availability schedule for a practitioner",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "weeklySchedule": { "type": "string" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId"]
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "Promotional discount code created by a practitioner",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "discountType": { "type": "string", "enum": ["fixed", "percentage"] },
        "discountValue": { "type": "number" },
        "isActive": { "type": "boolean" },
        "usageCount": { "type": "number" }
      },
      "required": ["code", "discountType", "discountValue"]
    },
    "PromoCodeUsage": {
      "title": "PromoCodeUsage",
      "description": "Historical usage log record when a promo code is applied during checkout",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "promoCodeId": { "type": "string", "maxLength": 128 },
        "promoCode": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 100 },
        "clientEmail": { "type": "string", "format": "email", "maxLength": 128 },
        "clientPhone": { "type": "string", "maxLength": 32 },
        "serviceTitle": { "type": "string", "maxLength": 128 },
        "appointmentRef": { "type": "string", "maxLength": 32 },
        "appliedAt": { "type": "string", "maxLength": 64 },
        "dateStr": { "type": "string", "maxLength": 64 },
        "originalPriceXOF": { "type": "number" },
        "discountAmountXOF": { "type": "number" },
        "finalPriceXOF": { "type": "number" }
      },
      "required": ["promoCode", "clientName", "clientEmail"]
    },
    "WebhookLog": {
      "title": "WebhookLog",
      "description": "Audit log for incoming subscription payment webhooks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "eventId": { "type": "string", "maxLength": 128 },
        "provider": { "type": "string", "maxLength": 64 },
        "userEmail": { "type": "string", "format": "email", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "planAssigned": { "type": "string", "maxLength": 32 },
        "amountXOF": { "type": "number" },
        "status": { "type": "string", "enum": ["Success", "Failed", "Rejected"] },
        "receivedAt": { "type": "string", "maxLength": 64 },
        "payloadJson": { "type": "string" },
        "error": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "status", "receivedAt"]
    },
    "SubscriptionSetting": {
      "title": "SubscriptionSetting",
      "description": "Global application configuration for subscriptions, pricing, checkout link, and webhook secret",
      "type": "object",
      "properties": {
        "proPriceXOF": { "type": "number" },
        "checkoutUrl": { "type": "string", "maxLength": 500 },
        "webhookSecret": { "type": "string", "maxLength": 256 },
        "freeMaxServices": { "type": "number" },
        "proMaxServices": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      }
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Appointments and bookings"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Service catalog"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Patient/client directory"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Payment transactions"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/offers/{offerId}": {
      "schema": { "$ref": "#/entities/Offer" },
      "description": "Public explore posts and offers"
    },
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/Schedule" },
      "description": "Availability schedules"
    },
    "/promoCodes/{promoCodeId}": {
      "schema": { "$ref": "#/entities/PromoCode" },
      "description": "Promotional discount codes"
    },
    "/promoCodeUsages/{usageId}": {
      "schema": { "$ref": "#/entities/PromoCodeUsage" },
      "description": "Promo code application history logs"
    },
    "/webhookLogs/{logId}": {
      "schema": { "$ref": "#/entities/WebhookLog" },
      "description": "Incoming webhook logs and sales audit history"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SubscriptionSetting" },
      "description": "System settings and subscription pricing configuration"
    }
  }
}
