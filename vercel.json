{
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/subscription",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|webhooks|subscription|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
